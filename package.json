{
  "name": "pi-delegation-policy",
  "version": "0.4.0",
  "private": false,
  "description": "A Pi extension for configurable delegation intensity and exact subagent role model references.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/Yivas/pi-delegation-policy",
  "bugs": "https://github.com/Yivas/pi-delegation-policy/issues",
  "homepage": "https://yivas.github.io/pi-delegation-policy/",
  "keywords": [
    "pi-package",
    "pi-extension",
    "delegation",
    "subagents",
    "model-selection"
  ],
  "files": [
    "src",
    "schema",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.3",
    "@earendil-works/pi-coding-agent": ">=0.84.3",
    "@earendil-works/pi-tui": ">=0.84.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
